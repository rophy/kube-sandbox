# Multi-stage build for Lambda with pre-cached Terraform providers
#
# Build: docker build -f Dockerfile.lambda -t kube-sandbox-lambda .
# Push:  docker push <your-dockerhub>/kube-sandbox-lambda:latest

# Stage 1: Download terraform providers
FROM hashicorp/terraform:1.7 AS provider-cache

WORKDIR /workspace

# Copy only the files needed to determine provider requirements
COPY terraform/*.tf ./terraform/

# Create a minimal backend override to skip S3 backend during init
RUN printf 'terraform {\n  backend "local" {}\n}\n' > terraform/backend_override.tf

# Download providers to /plugins directory
RUN cd terraform && terraform init -backend=false \
    && terraform providers mirror /plugins

# Stage 2: Lambda runtime with terraform
FROM public.ecr.aws/lambda/python:3.12

# Install terraform binary
RUN dnf install -y unzip \
    && curl -sLo /tmp/terraform.zip https://releases.hashicorp.com/terraform/1.7.0/terraform_1.7.0_linux_amd64.zip \
    && unzip /tmp/terraform.zip -d /usr/local/bin/ \
    && rm /tmp/terraform.zip \
    && dnf clean all

# Copy pre-cached providers from builder stage
COPY --from=provider-cache /plugins /opt/terraform-plugins

# Configure terraform to use cached plugins (no network downloads)
ENV TF_PLUGIN_CACHE_DIR=/opt/terraform-plugins

# Copy terraform configuration (for destroy operation)
COPY terraform/*.tf ${LAMBDA_TASK_ROOT}/terraform/

# Copy Lambda handler
COPY lambda/idle_checker/main.py ${LAMBDA_TASK_ROOT}/

# Lambda handler
CMD ["main.handler"]
