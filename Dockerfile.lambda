# Multi-stage build for Lambda with pre-cached Terraform providers
#
# Build: docker build -f Dockerfile.lambda -t kube-sandbox-lambda .
# Push:  docker push <your-dockerhub>/kube-sandbox-lambda:latest

# Stage 1: Download and prepare terraform providers
FROM hashicorp/terraform:1.14 AS provider-cache

WORKDIR /workspace

# Copy cluster terraform files (used to determine provider requirements)
COPY terraform/cluster/*.tf ./terraform/cluster/

# Create a minimal backend override to skip S3 backend during init
RUN printf 'terraform {\n  backend "local" {}\n}\n' > terraform/cluster/backend_override.tf

# Initialize terraform to download providers, then copy them
RUN cd terraform/cluster && terraform init -backend=false

# Copy the initialized .terraform/providers directory
RUN cp -r terraform/cluster/.terraform/providers /providers

# Stage 2: Lambda runtime with terraform
FROM public.ecr.aws/lambda/python:3.12

# Install terraform, git, and openssh (for ssh-keygen in apply)
RUN dnf install -y unzip git openssh \
    && curl -sLo /tmp/terraform.zip https://releases.hashicorp.com/terraform/1.14.3/terraform_1.14.3_linux_amd64.zip \
    && unzip /tmp/terraform.zip -d /usr/local/bin/ \
    && rm /tmp/terraform.zip \
    && dnf clean all

# Copy pre-extracted providers from builder stage
COPY --from=provider-cache /providers /opt/terraform-providers

# Copy all Lambda handlers - each Lambda function specifies its own handler
COPY lambda/check.py lambda/apply.py lambda/destroy.py ${LAMBDA_TASK_ROOT}/

# Default handler (overridden by each Lambda function's image_config)
CMD ["check.handler"]
