# API image for check Lambda and K8s status server
#
# Single image with both binaries. MODE env var selects which to run:
# - MODE=lambda (default): runs check binary for Lambda
# - MODE=server: runs api binary for K8s
#
# Build: docker build -f Dockerfile.api -t kube-sandbox-api .

FROM golang:1.23-alpine AS builder

WORKDIR /build

# Install ca-certificates for HTTPS calls
RUN apk add --no-cache ca-certificates

# Copy go mod and source
COPY go.mod ./
COPY cmd/ ./cmd/
COPY internal/ ./internal/

# Build both binaries
RUN go mod tidy && \
    CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o check ./cmd/check && \
    CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o api ./cmd/api

# Final image based on Lambda runtime
FROM public.ecr.aws/lambda/provided:al2023

# Copy both binaries
COPY --from=builder /build/check /var/runtime/check
COPY --from=builder /build/api /var/runtime/api
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/

# Entrypoint script to select binary based on MODE
RUN echo '#!/bin/sh' > /var/runtime/bootstrap && \
    echo 'if [ "$MODE" = "server" ]; then exec /var/runtime/api; else exec /var/runtime/check; fi' >> /var/runtime/bootstrap && \
    chmod +x /var/runtime/bootstrap

# Default to Lambda mode
ENV MODE=lambda
